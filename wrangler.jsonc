{
  "name": "rechargo",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SPAM_GUARD",
        "class_name": "RecharGoSpamGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-spam-guard",
      "new_sqlite_classes": ["RecharGoSpamGuard"]
    }
  ]
}
